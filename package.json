{
  "name": "jira-user-guide-mcp",
  "version": "1.0.0",
  "description": "MCP server that builds MSTP-styled Word user guides from Jira issues, linked Confluence pages, and Figma designs.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jira-user-guide-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "e2e": "tsx scripts/check-keys.ts && tsx scripts/e2e-mcp.ts && tsx scripts/e2e-token.ts",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "docx": "^9.8.1",
    "dotenv": "^18.0.5",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}