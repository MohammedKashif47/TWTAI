# ---------------------------------------------------------------------------
# Default setup: Claude reads Jira, Confluence and Figma through the Atlassian
# and Figma MCP servers you already have. No API tokens are needed here.
# ---------------------------------------------------------------------------
GATHER_MODE=mcp

# Your Jira site. Used as the cloudId for the Atlassian MCP when you give only a key (no token needed).
ATLASSIAN_BASE_URL=https://kashiftwtai.atlassian.net

# Lets you give just the number: "create the user guide for 20" becomes KAN-20.
JIRA_PROJECT_KEY=KAN

# Values used on the title page and in the appendix when the sources do not give them
COMPANY_NAME=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
SUPPORT_URL=

# Where session images and finished guides go (defaults: ./workspace and ./output next to the server)
WORK_DIR=
OUTPUT_DIR=

# ---------------------------------------------------------------------------
# Optional. The Atlassian MCP cannot download attachment files, so Jira
# screenshots go through the session inbox folder. If you would rather have
# them downloaded automatically, fill these in together with ATLASSIAN_BASE_URL
# above (a read-only token is enough).
# Setting GATHER_MODE=token makes this server read Jira, Confluence and Figma
# itself instead of using the MCP servers.
# ---------------------------------------------------------------------------
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
FIGMA_TOKEN=
